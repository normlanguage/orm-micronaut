package orm.micronaut

import jakarta.inject.Inject
import micronaut.inject.context.annotation.Context
import micronaut.inject.context.annotation.Prototype
import orm.EntityManager
import orm.RepositoryContext
import std.core.Exception

@Prototype()
class MicronautRepositoryContext implements RepositoryContext {
  @Context()
  @Inject()
  EntityManager? current

  MicronautRepositoryContext() {
    this.current = null
  }

  public EntityManager store() {
    EntityManager? active = current
    if active != null {
      return active
    }
    throw Exception(message: "persistence context is unavailable")
  }
}
