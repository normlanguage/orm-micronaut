Module module() {
  return module(
    name: "orm.micronaut",
    version: 5,
    dependencies: [
      exportedDependency(repository: "github", name: "orm", version: 4),
      exportedDependency(repository: "github", name: "orm.hibernate", version: 5),
      dependency(repository: "github", name: "jakarta.inject", version: 6),
      dependency(repository: "github", name: "micronaut.inject", version: 6),
      dependency(repository: "github", name: "micronaut.jdbc.hikari", version: 3)
    ],
    binding: jarBinding(
      target: mavenJar(
        group: "io.micronaut.sql",
        artifact: "micronaut-hibernate-jpa",
        version: "7.1.2", resolution: sha256("45f1a36be0b6315c169a1b5dda7371c818cdb91ba98b21ee2c7bf0a6815b997d")
      ),
      api: []
    )
  )
}

